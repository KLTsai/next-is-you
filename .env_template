# Copy this file to the repository-root .env and fill only values needed locally.
# Keep .env private and untracked. Never put credentials in this template.

# LINE Login channel identifier. Local value; production Worker variable.
LINE_LOGIN_CHANNEL_ID=

# LINE Login credential. Local-only value; production Worker secret.
LINE_LOGIN_CHANNEL_SECRET=

# LINE Login callback URL. Local value; production Worker variable.
LINE_LOGIN_REDIRECT_URI=

# At least 32 UTF-8 bytes. Local-only value; production Worker secret.
SESSION_SIGNING_SECRET=

# Comma-separated LINE subject IDs allowed to sign in as organizers.
# Local value; provision the production allowlist outside tracked files.
ORGANIZER_LINE_SUBJECTS=

# LINE Messaging API push credential. Local-only value; production Worker secret.
LINE_CHANNEL_ACCESS_TOKEN=

# Test-only setting. Leave blank here; only wrangler.niy006.test.jsonc enables it.
NIY006_LOCAL_TEST_MODE=
