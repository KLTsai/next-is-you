{
  "name": "next-is-you",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:release": "bash scripts/check_release_tag.sh",
    "test:ui": "node --test frontend/test/*.test.js",
    "dev:local": "npm run build && uv run python src/local_runtime.py",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:rehearsal": "sh scripts/manual-rehearsal.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
